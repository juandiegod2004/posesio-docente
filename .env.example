# Supabase (públicas — se pueden exponer en el frontend). Valores locales impresos
# por `npm run supabase:status` dentro de backend/.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (Express) contra el que habla este frontend. En el navegador nunca se
# usa directamente: las llamadas del cliente van por rutas relativas /api/* y
# next.config.ts las reescribe hacia esta URL server-side (así el backend nunca
# queda expuesto directo a internet). Esta var solo la usa proxy.ts, que corre
# en el servidor y le pega directo al backend para resolver el rol del usuario.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile (site key, pública). El secret vive solo en Supabase Auth
# (config del backend), nunca en el frontend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
