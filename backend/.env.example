# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Base de datos (Supabase self-hosted / local via `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase (claves que imprime `supabase status`)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP del buzón propio del dominio (ej. IONOS) - correo transaccional sin
# plataforma externa; NO el SMTP institucional .gov.co (bloqueado por SPF/DMARC)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notificaciones@tu-dominio.co
SMTP_FROM_NAME=Posesión Docente - SED Magdalena
